# 行尾规则:Shell/文档保持 LF(进 WSL 用),Windows 脚本保持 CRLF
* text=auto
*.sh   text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.txt  text eol=lf
*.ps1  text eol=crlf
*.bat  text eol=crlf
scripts/bin/* text eol=lf
VERSION text eol=lf
*.html text eol=lf
*.ico  binary
*.png  binary
