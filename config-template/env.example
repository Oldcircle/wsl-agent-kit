# ~/.config/agent-kit/env 的样例(ai-config 会自动生成,通常不用手改)
# 这个文件被 ~/.bashrc 自动加载;权限应为 600。

# --- Qwen Code 走 OpenAI 兼容模式的三件套 ---
# export OPENAI_API_KEY="sk-xxxx"
# export OPENAI_BASE_URL="https://api.deepseek.com/v1"
# export OPENAI_MODEL="deepseek-v4-flash"

# --- 各家原生 Key(qwen 的 modelProviders 通过 envKey 引用) ---
# export DEEPSEEK_API_KEY="sk-xxxx"
# export ZHIPU_API_KEY="xxxx"
# export DASHSCOPE_API_KEY="sk-xxxx"
# export SILICONFLOW_API_KEY="sk-xxxx"   # 同时用于 ai-video 语音转写
